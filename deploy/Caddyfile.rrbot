# rrbot.nl on du7's house Caddy (/home/esaleh/dns-stack/caddy/Caddyfile, docker, host network).
# Paste below the pauta blocks; `public_site` is defined at the top of that file. DNS lives in
# du7/dns-zone/rrbot.tf (DNS-only, so TLS-ALPN on 443 reaches Caddy).
#
# Public: the landing page, signup, Mollie's webhook and Meta's WhatsApp webhook.
# Not public: the vehicle hooks (Home Assistant posts to http://192.168.2.68:8000 on the
# LAN). Nothing else may publish port 8000: on 2026-11-20 an old Tailscale Funnel path
# (/ritten) was found doing so, without this filter.

rrbot.nl {
	import public_site
	@internal path /hooks/*
	handle @internal {
		respond 404
	}
	handle {
		# The largest real post is Meta's webhook, a few KB.
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8000
	}
}

www.rrbot.nl {
	import public_site
	redir https://rrbot.nl{uri} 301
}
