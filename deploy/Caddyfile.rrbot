# rrbot.nl on du7's house Caddy (/home/esaleh/dns-stack/caddy/Caddyfile, docker, host network).
# Paste below the pauta blocks; `public_site` is defined at the top of that file. DNS lives in
# du7/dns-zone/rrbot.tf (DNS-only, so TLS-ALPN on 443 reaches Caddy).
#
# Public: the landing page, signup, Mollie's webhook and Meta's WhatsApp webhook.
# Not public: /selftest (sends WhatsApp messages to any number), the FastAPI docs, and the
# vehicle hooks (Home Assistant posts to http://192.168.2.68:8000 on the LAN).

rrbot.nl {
	import public_site
	@internal path /selftest /docs /docs/* /redoc /openapi.json /hooks/*
	handle @internal {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

www.rrbot.nl {
	import public_site
	redir https://rrbot.nl{uri} 301
}
