# Copy to .env and fill in. All variables are prefixed with RIT_.

# WhatsApp Cloud API
RIT_WHATSAPP_TOKEN=
RIT_WHATSAPP_PHONE_NUMBER_ID=
RIT_WHATSAPP_APP_SECRET=
RIT_WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# Meta Graph API version (default v25.0)
RIT_WHATSAPP_GRAPH_VERSION=v25.0
# Optional extra allow-list. Leave empty to accept any number registered in
# config/cars.yaml (recommended). If set, only this single number is accepted.
RIT_ALLOWED_SENDER=

# Onboarding: admin numbers (comma-separated, E.164 without '+') who can approve
# new users, and whether unregistered numbers may request to join.
RIT_ADMIN_NUMBERS=31612345678
RIT_ONBOARDING_ENABLED=true
# Maximum number of registered users/cars
RIT_MAX_USERS=5

# Trajectory (optional; without a key the google provider falls back to a link)
RIT_GOOGLE_MAPS_API_KEY=

# Plugin selection
RIT_TRAJECTORY_PROVIDER=maps_link
RIT_ODOMETER_SOURCE=whatsapp_manual
RIT_DELTA_ALLOCATOR=noop
RIT_PRIVATE_CAP_PLUGIN=warn
# Optional: a different private-cap plugin used ONLY for allow-listed numbers.
# Leave override empty to apply RIT_PRIVATE_CAP_PLUGIN to everyone.
RIT_PRIVATE_CAP_PLUGIN_OVERRIDE=
RIT_PRIVATE_CAP_OVERRIDE_NUMBERS=

# Compliance
RIT_PRIVATE_CAP_KM=500

# First-trip seed fallback (used only for cars/numbers not defined in
# config/cars.yaml; per-car seeds in cars.yaml take precedence)
RIT_SEED_ADDRESS=Home
RIT_SEED_ODOMETER=145000
